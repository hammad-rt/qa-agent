# Copy to .env (chmod 600). Never commit .env.
LLM_BASE_URL=https://ai.rolustech.com/v1
LLM_MODEL=gemma4
LLM_API_KEY=none
LLM_MAX_CONCURRENCY=2
# Ask the server for valid JSON from planner, reviewer and judge (vLLM supports it). 0 turns it off.
LLM_JSON_MODE=1
# Longest reply the model may write (the server default is only 512 tokens, which cuts plans off).
LLM_MAX_TOKENS=8192
REDMINE_URL=https://redmine.rolustech.com
REDMINE_API_KEY=
MAX_TOOL_CALLS_PER_CASE=40
MAX_MINUTES_PER_CASE=15
# Account passwords are added by the masked prompt at the plan gate, by the names in pack.yaml:
# SAVO_STAGING_PORTAL_PASSWORD=
# SAVOSTORE_CRM_PASSWORD=
# Memory (phase 2). Embeddings are optional; without Ollama it falls back to keyword search.
MEMORY_DB=memory/memory.db
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# Reliability (phase 3)
RUN_RETENTION=5
MIN_FREE_GB=5
# Report and email (phase 4). Email goes only to REPORT_EMAIL_TO; any other recipient is confirmed at the console.
REPORT_PDF=1
REPORT_EMAIL_TO=
SMTP_USER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_APP_PASSWORD is added by masked input, never typed here.

# --- Run mode (optional; unset = automatic mode for real runs) ---
# QA_INTERACTIVE=1          # ask at the plan gate / approvals (old prompts). Default unset = auto.
# QA_TEST=1                 # set by the unit suite only. Skips loading this .env and redirects
#                           # MEMORY_DB / prefs to temp dirs. Do not set for real runs.

# --- Stuck lookup ladder (optional; off when unset) ---
# DOCS_SEARCH_URL=          # SearXNG-style search endpoint, e.g. http://127.0.0.1:8080/search
# CONTEXT7_API_URL=         # Optional Context7-compatible HTTP API base
# CONTEXT7_API_KEY=         # Optional token for Context7
# CODE_ROOT=                # Default read-only code tree when pack.yaml has no code_root
# QA_CODE_ROOT=             # Alias for CODE_ROOT
# STUCK_LOOKUP_TIMEOUT_SEC=8
# STUCK_LOOKUP_MAX_SNIPPETS=3
# MEMORY_TURN_TOKEN_BUDGET=1200

# --- Tester speed / context (optional) ---
# TESTER_MAX_PAGE_CHARS=12000   # trimmed page state cap (was 30000)
# TESTER_KEEP_PAGE_READS=1      # only the latest page state stays in history
# PLAN_BATCH_TOKENS=6000        # planner batches by token budget
# PLAN_CONCURRENCY=3            # independent planner batches in parallel
# PARALLEL_READONLY=0           # 1 = run pack parallel_safe_cases concurrently (max 2–3)
# PARALLEL_READONLY_MAX=2
# CONTEXT_LEARNING=1            # 0 = static budgets only (no usefulness scoring)
# CONTEXT_BUDGET_NAVIGATE=1800  # per step-type token budgets (also READ/VERIFY/PREP/…)
# LOOKUP_DETERMINISTIC=1        # code contact/order lookups before LLM fallback

# Per-job models (unset = LLM_MODEL). Jobs: PLANNER, TESTER, JUDGE, VISION. Example, local Ollama for CAPTCHA tiles:
# LLM_VISION_MODEL=qwen2.5vl:3b
# LLM_VISION_BASE_URL=http://localhost:11434/v1
# CAPTCHA_SOLVE_IMAGES=1   # 0 = always hand the picture puzzle to a person
# CAPTCHA_ROUNDS=3
# Local reCAPTCHA tile classifier (3x3 grids). Download once into models/:
# curl -L -o models/recaptcha_cls_224.onnx https://huggingface.co/1simo/recaptcha-classification-57k-224/resolve/main/recaptcha_classification_57k_224.onnx
# CAPTCHA_TILE_THRESHOLD=0.5   # CAPTCHA_TILE_MODEL_OFF=1 sends every grid to the vision LLM
